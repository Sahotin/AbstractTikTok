# Proxy Configuration (Wandou HTTP)
# your_wandou_http_app_key
WANDOU_APP_KEY=

# Proxy Configuration (Kuaidaili)
# your_kuaidaili_secret_id
KDL_SECERT_ID=
# your_kuaidaili_signature
KDL_SIGNATURE=
# your_kuaidaili_username
KDL_USER_NAME=
# your_kuaidaili_password
KDL_USER_PWD=

# Proxy Configuration (Jisu HTTP)
# Get JiSu HTTP IP extraction key value
jisu_key=
# Get JiSu HTTP IP extraction encryption signature
jisu_crypto=

# Embedding Provider (Phase 3B)
EMBEDDING_PROVIDER=openai-compatible
EMBEDDING_MODEL=
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_TIMEOUT=30
EMBEDDING_MAX_RETRIES=2
EMBEDDING_RETRY_BASE_DELAY=0.25
EMBEDDING_BATCH_SIZE=100
EMBEDDING_MAX_CONCURRENCY=3
EMBEDDING_VERSION=embedding_v1

# Comment Analysis LLM (Phase 2)
LLM_PROVIDER=openai-compatible
LLM_MODEL=
LLM_BASE_URL=
LLM_API_KEY=
# DeepSeek Chat Completions requires json_object; other providers may support json_schema.
LLM_STRUCTURED_OUTPUT_MODE=json_object
LLM_TEMPERATURE=0
LLM_TIMEOUT=30
LLM_MAX_RETRIES=2
LLM_RETRY_BASE_DELAY=0.25
LLM_BATCH_SIZE=20
LLM_MAX_CONCURRENCY=5
LLM_MAX_REQUESTS_PER_MINUTE=
LLM_ESTIMATED_OUTPUT_TOKENS=150
# Optional, provider-specific prices used only for cost estimation/reporting.
LLM_INPUT_PRICE_PER_1M_TOKENS=
LLM_OUTPUT_PRICE_PER_1M_TOKENS=
